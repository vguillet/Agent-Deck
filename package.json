{
  "name": "agent-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "clients/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:assets",
    "build:assets": "npm run build:assets --workspace @agent-deck/stream-deck",
    "package:artifacts": "npm run package --workspace focus && npm run package --workspace @agent-deck/stream-deck",
    "clean": "tsc -b --clean",
    "dev": "AGENT_DECK_CONFIG=../../agent-deck.config.json npm run dev --workspace @agent-deck/cli -- server",
    "demo": "AGENT_DECK_CONFIG=../../agent-deck.demo.config.json npm run dev --workspace @agent-deck/cli -- server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
