{
  "name": "focus",
  "displayName": "Agent Deck Focus",
  "description": "Opens exact Cursor conversations and local Codex threads from Agent Deck.",
  "version": "0.5.1",
  "private": true,
  "publisher": "agent-deck",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.cjs",
  "exports": {
    "./package.json": "./package.json"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "Agent Deck",
      "properties": {
        "agentDeck.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:47831",
          "description": "Agent Deck core server URL."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-extension.mjs",
    "prepackage": "node scripts/prepare-package.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out release/agent-deck.focus-$npm_package_version.vsix"
  },
  "dependencies": {
    "@agent-deck/api-contract": "0.1.0",
    "@agent-deck/client-sdk": "0.1.0",
    "@agent-deck/domain": "0.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.8"
  }
}
